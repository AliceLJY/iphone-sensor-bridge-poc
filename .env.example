HOSTS=127.0.0.1
PORT=8765
INBOX=$HOME/Desktop/iphone-sensor-inbox-v2
# Set this or BRIDGE_TOKEN_FILE whenever HOSTS contains a non-loopback address. Never commit a value.
BRIDGE_TOKEN=
# Preferred for launchd: path to a user-owned regular file with mode 600.
BRIDGE_TOKEN_FILE=
MAX_BODY=209715200
# Only enable behind a reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false
